# Copiá este archivo a `.env` y editá los valores.
# `.env` está en .gitignore — nunca se commitea.

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=logitrack
DB_PASSWORD=
DB_NAME=logitrack
DB_SSLMODE=disable

# ── Email transaccional — Resend SMTP ────────────────────────────────────────
# Registro gratuito: https://resend.com
# 1. Creá una cuenta y generá un API key en resend.com/api-keys
# 2. Verificá tu dominio en resend.com/domains (o usá onboarding@resend.dev solo para pruebas)
# 3. Completá los valores de abajo.
# Sin SMTP_HOST configurado los emails quedan deshabilitados (el resto funciona igual).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# El dominio del FROM debe estar verificado en tu cuenta de Resend.
SMTP_FROM=LogiTrack <no-reply@tudominio.com>
# URL pública de la página de tracking del frontend (sin barra final).
TRACK_BASE_URL=http://localhost:5173

# ── OpenRouteService (opcional, para modo segura) ─────────────────────────────
# Registro gratuito: https://openrouteservice.org/dev/#/signup
# Con la key configurada, el modo segura usa ORS con avoid_polygons para
# rutear genuinamente alrededor de las zonas peligrosas. Sin la key, segura
# cae al fallback de OSRM con waypoints densos (mejor esfuerzo).
ORS_API_KEY=
# Opcional: URL custom de ORS (default https://api.openrouteservice.org).
# ORS_BASE_URL=

# Autenticación de Doble Factor
TWO_FA_ENCRYPTION_KEY=<base64_de_32_bytes_generado_con_openssl>
APP_NAME=LogiTrack

# Desarrollo
ENABLE_MASTER_2FA_CODE=true

# Producción (comentar o poner false)
# ENABLE_MASTER_2FA_CODE=false